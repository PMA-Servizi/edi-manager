// use prisma-8
enum EdiOperation {
  @@type('pg/text@1')
  DOWNLOAD = 'download'
  UPLOAD = 'upload'
}

enum EdiRecordType {
  @@type('pg/text@1')
  ANPROD = 'ANPROD'
  DESADV = 'DESADV'
  ORDERS = 'ORDERS'
  ORDRSP = 'ORDRSP'
  PACLIS = 'PACLIS'
  SELLIN = 'SELLIN'
  INVSUP = 'INVSUP'
  ORDLIS = 'ORDLIS'
  REMADV = 'REMADV'
  INVRPT = 'INVRPT'
  SLSRPT = 'SLSRPT'
  PRICAT = 'PRICAT'
  NOTACC = 'NOTACC'
  NOTADD = 'NOTADD'
  ORDPRP = 'ORDPRP'
}

model Customers {
  id              String(varchar) @id @onCreate(uuid(4))
  name            String(text)
  slug            String(varchar)
  sapCustomerCode String(varchar) @unique @map('sap_customer_number')
  catalogId       Int4            @default(1) @map('catalog_id')
}

enum EdiCodeType {
  @@type('pg/varchar@1')
  PARTITA_IVA = 'ZZ'
  CODICE_EAN_UCC = '14'
}

model Companies {
  id                     String(varchar) @id @onCreate(uuid(4))
  name                   String(text)
  slug                   String(varchar)
  division               String(varchar) @unique
  ediCompanyCode         String(varchar) @map('edi_company_code')
  ediCompanyCodeType     EdiCodeType     @map('edi_company_code_type')
  businessName           String(text)    @map('business_name')
  address                String(text)
  city                   String(text)
  province               String(varchar)
  postalCode             String(varchar) @map('postal_code')
  country                String(text)
  courtOfLaw             String(text)?   @map('court_of_law')
  ccia                   String(text)
  shareCapital           String(text)    @map('share_capital')
  raeeRegistrationNumber String(varchar) @map('raee_registration_number')
  pileRegistrationNumber String(varchar) @map('pile_registration_number')
}

enum RunOutcome {
  @@type("pg/text@1")
  SUCCCESS = 'success'
  FAIL = 'fail'
}

model Runs {
  id           String(varchar) @id @onCreate(uuid(4))
  createdAt    DateTime        @onCreate(now()) @map('created_at')
  updatedAt    DateTime        @onCreate(now()) @onUpdate(now()) @map('updated_at')
  outcome      RunOutcome
  errorMessage String(text)?   @map('error_message')

  flowId       String(varchar) @map('flow_id')
  flow         Flows           @relation(fields: [flowId], references: [id])
}

model Flows {
  id            String(varchar)  @id @onCreate(uuid(4))
  enabled       Boolean          @default(false)
  interval      Int2
  ediRecordType EdiRecordType    @map('edi_record_type')
  operation     EdiOperation

  customerId    String(varchar)  @map('customer_id')
  customer      Customers        @relation(fields: [customerId], references: [id])

  companyId     String(varchar)  @map('company_id')
  company       Companies        @relation(fields: [companyId], references: [id])

  lastRunId     String(varchar)? @map('last_run_id')
  lastRun       Runs?            @relation(fields: [lastRunId], references: [id])

  @@unique([customerId, companyId, ediRecordType, operation])
}

enum FileOutcome {
  @@type("pg/text@1")
  SUCCCESS = 'success'
  FAIL = 'fail'
}

model Files {
  id           String(varchar) @id @onCreate(uuid(4))
  createdAt    DateTime        @onCreate(now()) @map('created_at')
  filename     String(text)
  outcome      FileOutcome
  errorMessage String(text)?   @map('error_message')

  runId        String(varchar) @map('run_id')
  run          Runs            @relation(fields: [runId], references: [id])
}
